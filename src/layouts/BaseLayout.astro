---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  active?: string;
  tone?: 'grouped' | 'plain';
}

const { title, description, active = '', tone = 'grouped' } = Astro.props;
const siteName = 'zqaq';
const pageTitle = title === siteName ? title : `${title} · ${siteName}`;
const metaDescription = description ?? title;
const canonical = new URL(Astro.url.pathname, Astro.site);

const nav = [
  { href: '/', label: '首页', key: 'home' },
  { href: '/tools/', label: '工具', key: 'tools' },
  { href: '/search/', label: '搜索', key: 'search' },
  { href: '/about/', label: '关于', key: 'about' },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
    <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />
    <!-- Cloudflare Web Analytics --><script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "b0f3abdec10b497993c9d84850400cd6"}'></script><!-- End Cloudflare Web Analytics -->
  </head>
  <body class={tone === 'plain' ? 'plain' : undefined}>
    <header class="site-header">
      <div class="container header-inner">
        <a class="logo" href="/"><img class="logo-mark" src="/logo-icon.svg" alt="" width="22" height="22" />zqaq</a>
        <nav class="main-nav" aria-label="主导航">
          {nav.map((item) => (
            <a href={item.href} class={active === item.key ? 'active' : undefined}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <span>© 2026 zqaq</span>
        <span class="foot-links">
          <a href="/rss.xml">RSS</a>
          <a href="https://www.youtube.com/@qaqZ-w2d4p" target="_blank" rel="noopener">YouTube</a>
          <a href="https://x.com/Zqaqpb" target="_blank" rel="noopener">X</a>
        </span>
      </div>
    </footer>
  </body>
</html>
