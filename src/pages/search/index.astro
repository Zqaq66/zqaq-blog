---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { tools } from '../../data/tools';
import { fmtDate } from '../../lib/date';

interface Item {
  title: string;
  desc: string;
  meta: string;
  url: string;
  external: boolean;
  search: string;
}

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const items: Item[] = [
  ...posts.map((p) => ({
    title: p.data.title,
    desc: p.data.description,
    meta: fmtDate(p.data.pubDate),
    url: `/posts/${p.id}/`,
    external: false,
    search: `${p.data.title} ${p.data.description} ${p.data.category} ${p.data.tags.join(' ')}`.toLowerCase(),
  })),
  ...tools.map((t) => ({
    title: t.name,
    desc: t.desc,
    meta: t.language,
    url: t.url,
    external: true,
    search: `${t.name} ${t.repo} ${t.desc} ${t.language}`.toLowerCase(),
  })),
];
---

<BaseLayout title="搜索" active="search">
  <section class="page-head">
    <h1>搜索</h1>
  </section>

  <input
    id="site-search"
    class="search-box"
    type="search"
    placeholder="搜索"
    aria-label="搜索本站"
    autofocus
  />

  <div id="search-list">
    {items.map((item) => (
      <article class="post-item" data-search={item.search}>
        <div class="meta"><span>{item.meta}</span></div>
        <h3>
          <a
            href={item.url}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener' : undefined}
          >{item.title}</a>
        </h3>
      </article>
    ))}
  </div>
  <div class="empty" id="search-empty" hidden>没有匹配的内容。</div>

  <script>
    const input = document.getElementById('site-search') as HTMLInputElement | null;
    const rows = Array.from(document.querySelectorAll<HTMLElement>('#search-list .post-item'));
    const empty = document.getElementById('search-empty');

    const apply = () => {
      const q = (input?.value ?? '').trim().toLowerCase();
      let visible = 0;
      for (const el of rows) {
        const hit = !q || (el.dataset.search ?? '').includes(q);
        el.style.display = hit ? '' : 'none';
        if (hit) visible++;
      }
      if (empty) empty.hidden = visible > 0;
    };

    input?.addEventListener('input', apply);
    const initial = new URLSearchParams(location.search).get('q');
    if (initial && input) input.value = initial;
    apply();
  </script>
</BaseLayout>
