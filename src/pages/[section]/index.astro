---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sections } from '../../data/sections';
import { fmtDate } from '../../lib/date';

export function getStaticPaths() {
  return sections.map((s) => ({ params: { section: s.slug }, props: { section: s } }));
}

const { section } = Astro.props;
const posts = (await getCollection('posts'))
  .filter((p) => p.data.section === section.slug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={section.name} description={section.desc} active="home">
  <section class="page-head">
    <h1>{section.name}</h1>
  </section>

  {posts.length > 0 ? (
    <div class="group">
      {posts.map((post) => (
        <article class="row linked">
          <div class="row-main">
            <h3><a href={`/posts/${post.id}/`}>{post.data.title}</a></h3>
            <p class="row-desc">{post.data.description}</p>
          </div>
          <span class="row-side">{fmtDate(post.data.pubDate)}</span>
        </article>
      ))}
    </div>
  ) : (
    <div class="empty">暂无文章。</div>
  )}
</BaseLayout>
