---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { tools } from '../../data/tools';
---

<BaseLayout title="工具库" description="推荐过的 GitHub 开源工具沉淀清单，可搜索。" active="tools">
  <section class="hero">
    <h1>工具库</h1>
    <p>每一篇实测里推荐过的开源工具都会沉淀在这里，方便随时查用。星数为收录当日的快照。</p>
  </section>

  <input
    id="tool-search"
    class="search-box"
    type="search"
    placeholder="搜索工具名、用途或语言…"
    aria-label="搜索工具"
  />

  <div class="post-list" id="tool-list">
    {tools.map((t) => (
      <article
        class="tool-card"
        data-search={`${t.name} ${t.repo} ${t.desc} ${t.language}`.toLowerCase()}
      >
        <div class="tool-head">
          <h3><a href={t.url} target="_blank" rel="noopener">{t.name}</a></h3>
          <span class="stars">★ {t.stars}</span>
          <span class="lang">{t.language}</span>
        </div>
        <p>{t.desc}</p>
        <div class="meta" style="margin-top:0.5rem">
          <span>{t.repo}</span>
          <span>收录于 {t.addedDate}</span>
        </div>
      </article>
    ))}
  </div>
  <div class="empty" id="tool-empty" hidden>没有找到匹配的工具。</div>

  <script>
    const input = document.getElementById('tool-search');
    const cards = Array.from(document.querySelectorAll('.tool-card'));
    const empty = document.getElementById('tool-empty');
    input?.addEventListener('input', () => {
      const q = (input as HTMLInputElement).value.trim().toLowerCase();
      let visible = 0;
      for (const card of cards) {
        const el = card as HTMLElement;
        const hit = !q || (el.dataset.search ?? '').includes(q);
        el.style.display = hit ? '' : 'none';
        if (hit) visible++;
      }
      if (empty) (empty as HTMLElement).hidden = visible > 0;
    });
  </script>
</BaseLayout>
