---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { tools } from '../../data/tools';

const languages = [...new Set(tools.map((t) => t.language))].sort();
---

<BaseLayout title="工具" active="tools">
  <section class="page-head">
    <h1>工具</h1>
  </section>

  <input
    id="tool-search"
    class="search-box"
    type="search"
    placeholder="搜索"
    aria-label="搜索工具"
  />

  <div class="chip-row" role="group" aria-label="按语言筛选">
    <button type="button" class="chip" data-lang="" aria-pressed="true">全部</button>
    {languages.map((lang) => (
      <button type="button" class="chip" data-lang={lang} aria-pressed="false">{lang}</button>
    ))}
  </div>

  <div id="tool-list">
    {tools.map((t) => (
      <article
        class="tool-item"
        data-lang={t.language}
        data-search={`${t.name} ${t.repo} ${t.desc} ${t.language}`.toLowerCase()}
      >
        <div class="tool-head">
          <h3><a href={t.url} target="_blank" rel="noopener">{t.name}</a></h3>
          <span class="stars">★ {t.stars}</span>
          <span class="lang">{t.language}</span>
        </div>
        <p>{t.desc}</p>
      </article>
    ))}
  </div>
  <div class="empty" id="tool-empty" hidden>没有匹配的工具。</div>

  <script>
    const input = document.getElementById('tool-search') as HTMLInputElement | null;
    const cards = Array.from(document.querySelectorAll<HTMLElement>('#tool-list .tool-item'));
    const empty = document.getElementById('tool-empty');
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip[data-lang]'));
    let activeLang = '';

    const apply = () => {
      const q = (input?.value ?? '').trim().toLowerCase();
      let visible = 0;
      for (const el of cards) {
        const hitText = !q || (el.dataset.search ?? '').includes(q);
        const hitLang = !activeLang || el.dataset.lang === activeLang;
        const hit = hitText && hitLang;
        el.style.display = hit ? '' : 'none';
        if (hit) visible++;
      }
      if (empty) empty.hidden = visible > 0;
    };

    input?.addEventListener('input', apply);
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        activeLang = chip.dataset.lang ?? '';
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        apply();
      });
    });
    apply();
  </script>
</BaseLayout>
